# Copy this file to .env (same folder as server.js) and fill in the values.
# .env is ignored by git: never commit it.

# Hash of the upload access code. Generate it with: node scripts/hash_code.js
UPLOAD_CODE_HASH=

# Port the app listens on: must match the port set in your hosting panel.
PORT=

# Optional: enables the AI debriefs (paid API calls).
# ANTHROPIC_API_KEY=
